# Copy this file to .env and fill in real values.
# Never commit the real .env file — it's already in .gitignore.

# --- Database ---
# When running via docker compose, the backend service overrides this to
# point at the "postgres" container automatically. This value is used when
# running the backend directly on your machine (outside Docker).
DATABASE_URL=postgresql://databound:databound@localhost:5432/databound

# --- Security ---
JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- AI / LLM provider (Phase 5) ---
# REQUIRED for Chat to generate answers — get a key at console.anthropic.com.
# Retrieval (search) works fine without this; only answer generation needs it.
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-6
EMBEDDING_MODEL=text-embedding-3-small

# --- Embeddings (Phase 4) ---
# "local" works immediately with no API key (lexical similarity via a
# hashing scheme — see app/services/embeddings.py). Set to "openai" for
# real semantic embeddings; requires LLM_API_KEY to be an OpenAI key.
EMBEDDING_PROVIDER=local
EMBEDDING_DIMENSIONS=384

# --- Chunking (Phase 4) ---
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# --- Retrieval tuning (Phase 4/5) ---
TOP_K=5
# Calibrated for the LOCAL embedding provider — see the long comment on
# this setting in app/config.py before changing it. Raise toward 0.6-0.75
# if you switch EMBEDDING_PROVIDER to "openai".
SIMILARITY_THRESHOLD=0.3

# --- File handling ---
MAX_FILE_SIZE=20971520

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
